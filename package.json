{
  "name": "explicitjs",
  "version": "1beta6",
  "private": false,
  "type": "module",
  "description": "A semantic clarity enforcer for production JavaScript & TypeScript.",
  "license": "AGPL-3.0-only",
  "bin": {
    "explicitjs": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node src/cli.ts",
    "lint": "node src/cli.ts src",
    "test": "node --test \"test/*.test.ts\"",
    "check": "tsc --noEmit",
    "fmt": "biome check --write .",
    "fmt:check": "biome ci .",
    "update-nfo": "bash scripts/update-nfo.sh",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "typescript6": "npm:typescript@^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.14.0"
}
